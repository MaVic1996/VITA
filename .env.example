# Ollama
VITA_OLLAMA_MODEL=gemma4
VITA_OLLAMA_BASE_URL=http://localhost:11434

# Whisper.cpp
VITA_WHISPER_EXECUTABLE=/absolute/path/to/whisper.cpp/build/bin/whisper-cli
VITA_WHISPER_MODEL=/absolute/path/to/whisper.cpp/models/ggml-small.bin

# Piper
VITA_PIPER_EXECUTABLE=/absolute/path/to/VITA/.venv/bin/piper
VITA_PIPER_MODEL=/absolute/path/to/VITA/models/piper/es_ES-davefx-medium.onnx
